# Server Configuration
PORT=5000
NODE_ENV=development
REPO_MODE=memory
# Set MONGODB_URI when REPO_MODE=mongo
MONGODB_URI=mongodb://localhost:27017/solace

# CORS Configuration (exact origin allowlist, no wildcards)
CORS_ORIGIN=http://localhost:3000

# Security Secrets (Must be at least 256-bit / 32 characters in production)
JWT_ACCESS_SECRET=your_minimum_32_character_random_access_secret_key_here
JWT_REFRESH_SECRET=your_minimum_32_character_random_refresh_secret_key_here
COOKIE_SECRET=your_minimum_32_character_random_cookie_signing_secret_here
# 64 hex characters (32 bytes = 256 bits) for AES-256-GCM field encryption
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CSRF_SECRET=your_minimum_32_character_random_csrf_secret_key_here

# Storage
STORAGE_DIR=./storage

# Trust Proxy (false in local dev, number of hops or true behind reverse proxy)
TRUST_PROXY=false
